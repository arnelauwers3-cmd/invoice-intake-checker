# Gemini API key from https://aistudio.google.com/apikey (server-side only)
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-lite-latest)
GEMINI_MODEL=

# Supabase project URL and secret key (Project Settings → API Keys → Secret keys).
# Server-side only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
